<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project X</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #050505;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    .container {
      padding: 40px;
    }

    h1 {
      font-size: 64px;
      letter-spacing: 8px;
      margin-bottom: 15px;
    }

    p {
      font-size: 18px;
      color: #999;
      letter-spacing: 3px;
    }

    .line {
      width: 80px;
      height: 3px;
      background: white;
      margin: 25px auto;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>PROJECT X</h1>
    <div class="line"></div>
    <p>DISCIPLINE • DETERMINATION • FOCUS</p>
  </div>

</body>
</html>
